---
/**
 * A tiny inline icon set. Without iconography a page reads as an
 * undifferentiated wall of text: there is no non-textual way to tell
 * one program, one benefit or one symptom from another.
 *
 * Inline rather than files in `assets/icons/` on purpose — these are
 * 24px stroke glyphs that must inherit `currentColor` and the caller's
 * stroke weight. Fold them into assets/icons/ + astro:assets if the
 * direction is accepted and the set grows past a handful.
 */
interface Props {
  name:
    | 'arrow'
    | 'check'
    | 'user'
    | 'users'
    | 'clipboard'
    | 'download'
    | 'sparkle'
    | 'quote'
    | 'menu'
    | 'pin'
    /* The logo's four petals, as line art — see the note by their paths. */
    | 'hand'
    | 'eye'
    | 'ear'
    | 'spiral';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

/* 24x24, stroke-only, round joins — matches the logo's soft geometry. */
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15m0 0-6-6m6 6-6 6"/>',
  check: '<path d="m5 13 4 4 10-10"/>',
  user: '<circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  users:
    '<circle cx="9" cy="8.5" r="3"/><path d="M3 19.5a6 6 0 0 1 12 0"/><path d="M16 6.2a3 3 0 0 1 0 5.6"/><path d="M17.5 15.2a6 6 0 0 1 3.5 4.3"/>',
  clipboard:
    '<path d="M9 4.5h6v2H9z"/><path d="M9 5.5H7.5A1.5 1.5 0 0 0 6 7v12a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 18 19V7a1.5 1.5 0 0 0-1.5-1.5H15"/><path d="m9.5 13 2 2 3.5-4"/>',
  download:
    '<path d="M12 4v10.5m0 0 3.5-3.5M12 14.5 8.5 11"/><path d="M5 16.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19v-2.5"/>',
  sparkle:
    '<path d="M12 3.5c.9 4 2.6 5.7 6.5 6.5-3.9.8-5.6 2.5-6.5 6.5-.9-4-2.6-5.7-6.5-6.5 3.9-.8 5.6-2.5 6.5-6.5Z"/><path d="M17.5 16.5c.4 1.8 1.2 2.6 3 3-1.8.4-2.6 1.2-3 3-.4-1.8-1.2-2.6-3-3 1.8-.4 2.6-1.2 3-3Z"/>',
  quote:
    '<path d="M9.5 6.5C6.9 7.9 5.5 10.1 5.5 13v4.5h5V13H8c0-1.9.7-3.3 2.4-4.3ZM19 6.5c-2.6 1.4-4 3.6-4 6.5v4.5h5V13h-2.5c0-1.9.7-3.3 2.4-4.3Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  pin: '<path d="M12 21s6.5-6 6.5-10.5a6.5 6.5 0 0 0-13 0C5.5 15 12 21 12 21Z"/><circle cx="12" cy="10.5" r="2.5"/>',

  /* THE LOGO'S FOUR PETALS, redrawn as 24px strokes: a hand, an eye, an
     ear and a spiral, in the same order the mark puts them (teal hand,
     amber eye, coral ear, purple spiral — see logo-mark.svg). The
     schedule grid gives one to each age group, which is what the
     clinic's own timetable graphic does, so a row is identifiable by its
     petal before it's read.

     They're filled shapes in the mark and strokes here on purpose: at
     28px inside a tinted tile the solid petals turn into blobs, and
     every other glyph on the site is a 1.75 stroke. What carries over is
     which shape belongs to which hue, not how it's drawn. */
  hand:
    '<path d="M9 11.5V7a1.25 1.25 0 1 1 2.5 0v4"/><path d="M11.5 11V5.5a1.25 1.25 0 1 1 2.5 0V11"/><path d="M14 11V7a1.25 1.25 0 1 1 2.5 0v6.5"/><path d="M9 11.5 7.3 9.2a1.3 1.3 0 0 0-2.1 1.5l2.4 4.9A6 6 0 0 0 13 19.5h.5a5 5 0 0 0 5-5v-1.5"/>',
  eye: '<path d="M3.5 12S6.9 6 12 6s8.5 6 8.5 6-3.4 6-8.5 6-8.5-6-8.5-6Z"/><circle cx="12" cy="12" r="2.75"/>',
  ear:
    '<path d="M7.4 20.5c0-1.5-.8-2.4-1.4-3.6-.6-1.2-.8-2.3-.8-4.4a6.8 6.8 0 1 1 13.6 0c0 3-2 4.4-3.6 5.3-1 .6-1.3 1.3-1.6 2.2-.3.9-1 1.5-2 1.5a2 2 0 0 1-2-2"/><path d="M9.6 12.5a2.4 2.4 0 1 1 4.8 0c0 1.3-.8 1.9-1.6 2.5"/>',
  spiral: '<path d="M12 11.1a1.75 1.75 0 0 1 0 3.5 3.45 3.45 0 0 1 0-6.9 5.15 5.15 0 0 1 0 10.3"/>',
};

/* `arrow` points in the reading direction, so it has to flip under RTL —
   it's the one glyph in the set that carries direction. */
const directional = name === 'arrow';
---

<svg
  class:list={[className, directional && 'icon-directional']}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>

<style>
  :global([dir='rtl']) .icon-directional {
    transform: scaleX(-1);
  }
</style>
