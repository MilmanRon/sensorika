---
/**
 * Example `ui/` primitive — generic, content-agnostic, reusable
 * anywhere. Styled entirely from design tokens (src/styles/tokens.css),
 * never a one-off color/spacing value. Use this as the template for
 * new primitives (Card, Badge, Input, ...).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  /**
   * `md` is the page-level default (hero CTAs, forms). `sm` exists for
   * dense chrome — the header bar is 4rem tall, so an `md` button in it
   * would leave almost no breathing room above and below.
   */
  size?: 'sm' | 'md';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 rounded-control font-display font-semibold transition-colors duration-[var(--duration-base)]';
const sizes = {
  sm: 'px-4 py-2 text-base',
  md: 'px-6 py-3',
};
/*
 * Neither variant uses a -500 logo value: the petals are pastels (coral
 * 3.0:1 on white, teal 2.32:1), so a filled button in one can't legibly
 * carry its own label and an outlined one can't be read. Both sit on a
 * darkened step off the exact logo color instead — coral-700 at 5.20:1
 * and teal-700 at 5.92:1, each of them legible as a fill under white
 * text and as text on white.
 *
 * Primary is coral, the logo's red square: it is the page's one
 * conversion action, and a page whose every other interactive surface
 * is teal needs it to separate from them rather than blend in.
 * Secondary stays in teal — as an outline in the *accent* hue it reads
 * as the quieter, non-committal action, which is exactly what a second
 * coral button next to the first would not.
 *
 * Hover on either just steps one shade deeper rather than changing hue.
 */
const variants = {
  primary: 'bg-coral-700 text-white hover:bg-coral-800',
  secondary: 'border border-teal-700 bg-transparent text-teal-700 hover:bg-teal-50',
};
---

<Tag href={href} class={`${base} ${sizes[size]} ${variants[variant]} ${className}`} {...rest}>
  <slot />
</Tag>
