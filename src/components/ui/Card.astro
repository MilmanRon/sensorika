---
/**
 * The site's one surface. What it is, and why:
 *
 * 1. The accent is an icon tile + a hairline ring in the same hue,
 *    rather than a 4px bar on the inline start. A bar reads as a stray
 *    rule rather than as the card's identity, and it can't carry a
 *    glyph — so a row of cards would be distinguishable only by a
 *    colored line most readers won't register.
 * 2. A hover state. Every card that contains a CTA is a target, and
 *    without one it gives no feedback until you reach the button.
 * 3. A large, very faint petal of the accent hue bleeding out of the
 *    top corner, so a card is a *surface* with something on it rather
 *    than a white rectangle. It's clipped by the card and sits behind
 *    the content.
 *
 * The `accent` prop keeps its contract: a petal-hue name, never a raw
 * color, so it can still only resolve to a token. Ring and corner wash
 * are both ornament, which is why they may take a petal at all — the
 * card's button stays teal like every other control on the site.
 *
 * The corner petal is opt-OUT (`petal={false}`) rather than opt-in, so
 * every card that existed before this prop looks exactly as it did. It
 * was drawn for a GRID of cards, where you see one or two at a time; in
 * a tall stack of full-width panels the same shape at the same corner
 * at the same size stops being a flourish and becomes a repeating tile.
 * See ProsePanel, which turns it off for that reason.
 */
interface Props {
  accent?: 'coral' | 'teal' | 'amber' | 'purple';
  /** Adds hover lift + ring. Off for cards that aren't a target. */
  interactive?: boolean;
  /** Decorative corner wash. Turn off where cards stack and it repeats. */
  petal?: boolean;
  /** How much air the card holds. See `pads` below. */
  pad?: 'tight' | 'default' | 'prose';
  class?: string;
  [key: string]: unknown;
}

const {
  accent,
  interactive = false,
  petal = true,
  pad = 'default',
  class: className = '',
  ...rest
} = Astro.props;

/* Ring at rest / on hover, and the wash for the corner petal. One row
   per hue so a lookup can never produce an untokenized value. */
const accents = {
  coral: 'ring-coral-500/25 hover:ring-coral-500/60 [--petal:var(--color-coral-50)]',
  teal: 'ring-teal-500/25 hover:ring-teal-500/60 [--petal:var(--color-teal-50)]',
  amber: 'ring-amber-500/25 hover:ring-amber-500/60 [--petal:var(--color-amber-50)]',
  purple: 'ring-purple-500/25 hover:ring-purple-500/60 [--petal:var(--color-purple-50)]',
};

/*
 * Padding is a PROP, not a class the caller layers on top, because
 * layering doesn't work here: Tailwind emits `p-*` in ascending order,
 * so a caller's `sm:p-4` loses to a base `sm:p-8` no matter which order
 * the classes are written in. Two components were already fighting
 * that — one wrote `p-2 sm:p-4` and won only because the base had no
 * `sm:` step to beat, and its twin wrote `sm:p-4` and silently kept the
 * base `p-8` on phones. One lookup, one slot, no collision.
 *
 *   tight    lists whose ROWS carry their own padding (the accordions).
 *            The card here is a container, not a margin.
 *   default  a card with content directly on it.
 *   prose    a full-width panel of running text, where the padding is
 *            what holds the measure in from the edges.
 *
 * Every one of them starts smaller than it ends. These are absolute
 * values, and 32px a side is 18% of a 360px screen before the page's
 * own gutter has been paid — see the phone block in tokens.css.
 */
const pads = {
  tight: 'p-2 sm:p-4 lg:p-6',
  default: 'p-5 sm:p-8',
  prose: 'p-5 sm:p-12 lg:p-16',
};

const base = 'card relative overflow-hidden rounded-card bg-white shadow-card ring-1';
const ring = accent ? accents[accent] : 'ring-ink-900/10 [--petal:var(--color-teal-50)]';
---

<div
  class:list={[base, pads[pad], ring, interactive && 'card-interactive', className]}
  {...rest}
>
  {petal && <span class="petal" aria-hidden="true" />}
  <div class="relative">
    <slot />
  </div>
</div>

<style>
  .card {
    /* Tailwind v4 draws `ring-*` as a box-shadow, so one box-shadow
       transition covers both the elevation and the ring's hue change. */
    transition:
      box-shadow var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .card-interactive:hover,
  .card-interactive:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  /* Decorative wash, bled off the block-start inline-end corner. Sized
     in rem off the card's own padding so it scales with the card. */
  .petal {
    position: absolute;
    inset-block-start: -5rem;
    inset-inline-end: -5rem;
    width: 14rem;
    height: 14rem;
    border-radius: var(--radius-blob);
    background: var(--petal);
  }
</style>
