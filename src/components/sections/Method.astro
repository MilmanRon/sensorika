---
/**
 * "השיטה שלנו" — the explanatory heart of the page: what the clinic
 * actually looks for in a child, and why behavior that reads as refusal
 * is usually difficulty.
 *
 * It's a long read for a landing page, so it's set on a prose measure
 * (--width-prose) rather than the full content width, and the copy is
 * split into three parts that get three different weights:
 *   - a lead line, larger, that states the promise;
 *   - the body, which explains the mechanism and then lists what it
 *     looks like day to day;
 *   - a closing line, pulled out on its own, that's the sentence a
 *     parent is meant to leave with.
 *
 * Copy lives here rather than in the `articles` collection because it's
 * page furniture — a section of the landing page — not a piece of
 * long-form parent material with its own URL.
 */
const lead = 'אנחנו עוזרים להבין מה בדיוק מקשה על הילד להתמודד';

const body = [
  'באמצעות תנועה וחוויה חושית המאורגנת באופן מותאם, אנחנו יוצרים תנאים שבהם הילד יכול לרכוש את מה שקשה לו היום, לצבור חוויות של הצלחה, להיות פחות ופחות תלוי בעזרת מבוגר ובהדרגה להפוך לעצמאי יותר.',
  'לעיתים קרובות, מאחורי הקשיים שאנחנו רואים בחיי היומיום עומדים מאפיינים של עיבוד חושי ושל הארגון התפקודי של מערכת העצבים.',
  'הילד יכול להיות כל הזמן בתנועה — או להפך, להימנע מפעילות. להתעייף מעומס במהירות, להתקשות להתרכז ולעבור מפעילות אחת לאחרת, להתקשות לווסת את עוצמת הכוח, לנוע בצורה מסורבלת, להתקשות ברכישת דברים חדשים, להגיב בעוצמה לרעש, למגע או לתנועה.',
  'יכול להיות לו קשה להתמודד עם תגובות רגשיות חזקות, לפעול לפי כללים משותפים, ליצור אינטראקציה עם ילדים אחרים — או שהוא יכול לוותר על הניסיון עוד לפני שהתחיל.',
];

const closing = 'לפעמים מה שנראה כמו ״לא רוצה״, בעצם אומר ״קשה לו״.';
---

<section id="method" class="py-section lg:py-section-lg">
  <div class="mx-auto max-w-[var(--width-prose)] px-gutter lg:px-gutter-lg">
    <h2 class="font-display text-3xl leading-heading font-bold text-ink-900 sm:text-4xl">
      השיטה שלנו
    </h2>

    <p class="mt-6 text-xl leading-body font-medium text-ink-800">{lead}</p>

    <div class="mt-6 flex flex-col gap-5 text-lg leading-body text-ink-700">
      {body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <!--
      The closing line is the section's takeaway, so it gets a rule on
      the inline start instead of being a fifth body paragraph. `border-s`
      is logical — it lands on the right under dir=rtl on its own.
    -->
    <p
      class="mt-10 border-s-4 border-s-teal-500 ps-6 font-display text-xl leading-body font-semibold text-ink-900 sm:text-2xl"
    >
      {closing}
    </p>
  </div>
</section>
