---
/**
 * The shared body of a nav-item page: intro band + (on the forms page)
 * its timetable, its venue and its downloads + a stack of accented
 * ProsePanels + (on the individual page) its collapsed packages and
 * terms + (on the FAQ) an accordion. Everything a page differs in
 * — its title, its opening line, how its copy splits into panels — comes
 * from one .md file in the `pages` collection, so a copy change is a
 * content edit and never a component edit.
 *
 * This started as SensoryRegulation.astro, which was that page's copy
 * and its layout in one file. It's generalized here because there are
 * six of these pages and they're all the same shape: what changes per
 * page is the words.
 *
 * THE PANELS THEMSELVES are PanelStack's — this file decides what a page
 * is made of and in what order, not how a run of panels is drawn. The
 * packages page needs a second stack (its terms, under their own
 * heading, below the collapsed packages), and the same forty lines
 * written twice in one file is how two stacks quietly stop matching.
 *
 * DECORATION: this page draws none of its own, and neither do its
 * panels (ProsePanel turns Card's corner petal off). The rule these
 * pages settled: the ornament belongs to the PAGE, not to each card —
 * repeated down a stack the corner blob became a tile you notice
 * instead of a flourish you don't.
 *
 * The intro band used to carry a <Decor> — the hero's petals, without
 * the dot grid — back when the route rendered on flat white. It doesn't
 * any more: the route now puts a PageBackdrop under the whole document,
 * exactly as the home page does, and that runs a petal field
 * (plus the wash and the dither) down the entire page. A second set of
 * shapes in the one band the two would overlap reads as clutter, which
 * is the same call HeroMethod made when the backdrop arrived under it.
 * The panels' white Card surfaces now lift off that ground instead of
 * sitting white-on-white.
 */
import type { CollectionEntry } from 'astro:content';

import DisclosureList from './DisclosureList.astro';
import DocumentList from './DocumentList.astro';
import FaqList from './FaqList.astro';
import PanelStack from './PanelStack.astro';
import ScheduleGrid from './ScheduleGrid.astro';
import Venue from './Venue.astro';

interface Props {
  /** A `pages` collection entry's frontmatter. */
  page: CollectionEntry<'pages'>['data'];
}

const { page } = Astro.props;

/* The intro band's own bottom padding is the gap down to whatever comes
   first, so the FIRST block on a page carries no top margin and every
   block after it adds one. Which block is first now depends on the page
   — the timetable, the downloads, or the panels — so it's worked out
   here rather than each block guessing. */
const gap = 'mt-14 lg:mt-20';
const beforeDocuments = Boolean(page.schedule || page.venue);
const beforePanels = beforeDocuments || Boolean(page.documents);
---

<section class="pb-section lg:pb-section-lg">
  <div class="mx-auto max-w-[var(--width-content)] px-gutter lg:px-gutter-lg">
    <!--
      The intro band: title and opening line, on the backdrop's own
      ground. Its `pb-*` is the gap down to the first panel, which is
      why the stack below carries no top margin — it also keeps the
      title clear of the panel stack while the backdrop's petals drift
      behind both.

      The band's own top padding is the gap up to the header, and it
      matches that bottom gap rather than adding to the section's
      `py-section` — hence `pb-section` on the section and a symmetric
      `py-*` here. A full section's worth of air under a sticky bar
      read as the page starting late; the title now sits as far below
      the header as the first panel sits below the title.
    -->
    <div class="py-14 lg:py-20">
      <!-- One size step below the home page's h1 (no lg:text-6xl): an
           interior page shouldn't shout as loud as the greeting does. -->
      <h1
        class="text-center font-display text-4xl leading-heading font-bold text-balance text-ink-900 sm:text-5xl"
      >
        {page.title}
      </h1>

      {
        page.intro && (
          <p class="mx-auto mt-6 max-w-[var(--width-prose)] text-center text-lg leading-body text-pretty text-ink-700 sm:text-xl">
            {page.intro}
          </p>
        )
      }
    </div>

    {/*
      WHEN AND WHERE FIRST, above everything else on the page.

      On the group program's page the panels are its terms and the
      downloads are its paperwork, and both of them answer questions a
      parent only has once they've decided the program could work for
      them. Whether it can work is a timetable question: two afternoons,
      an age group, a street. So the schedule and the venue open the
      page, and the forms follow.

      Neither block is on any other page today — both are frontmatter
      switches, and a page that sets neither opens exactly as it did.
    */}
    {
      page.schedule && (
        <ScheduleGrid
          heading={page.schedule.heading}
          intro={page.schedule.intro}
          note={page.schedule.note}
        />
      )
    }

    {/* Tight under the grid rather than a section apart: the venue is
        the rest of the same answer, not the page's next subject. */}
    {page.venue && <Venue class={page.schedule ? 'mt-6' : ''} />}

    {/*
      Downloads before the panels, not after: on the forms page the two
      PDFs are what the visitor came for, and the terms under them are
      what they read once they have them. A page with no `documents`
      (all six nav pages today) is unchanged — the panels still open
      directly under the intro band.
    */}
    {
      page.documents && (
        <DocumentList
          heading={page.documents.heading}
          intro={page.documents.intro}
          items={page.documents.items}
          class={beforeDocuments ? gap : ''}
        />
      )
    }

    {
      page.panels.length > 0 && (
        <PanelStack panels={page.panels} class={beforePanels ? gap : ''} />
      )
    }

    {/*
      Disclosures AFTER the panels, where the downloads come before
      them: a page's panels are the argument a parent reads, and the
      rows below are what they consult once they've read it — prices,
      the small print. Closed, they cost the reader a line each.
    */}
    {
      page.disclosures && (
        <DisclosureList
          heading={page.disclosures.heading}
          intro={page.disclosures.intro}
          items={page.disclosures.items}
          class="mt-14 lg:mt-20"
        />
      )
    }

    {/*
      Terms LAST, and open — see the schema's note on why they aren't
      more disclosure rows. Their heading matches the disclosure block's
      so the two read as the page's two sections, and the panels under it
      drop to h3 so the outline doesn't put one level with the block that
      contains it.

      `mt-12` rather than the `mt-14` above: this is the gap between two
      sections of the same page, not the gap between the page's argument
      and its reference matter.
    */}
    {
      page.terms && (
        <section class="mt-12 lg:mt-16">
          <h2 class="text-center font-display text-2xl leading-heading font-bold text-balance text-ink-900 sm:text-3xl">
            {page.terms.heading}
          </h2>

          {page.terms.intro && (
            <p class="mx-auto mt-4 max-w-[var(--width-prose)] text-center text-lg leading-body text-pretty text-ink-700">
              {page.terms.intro}
            </p>
          )}

          <PanelStack panels={page.terms.panels} headingAs="h3" class="mt-8" />
        </section>
      )
    }

    {page.faq.length > 0 && <FaqList items={page.faq} />}
  </div>
</section>
