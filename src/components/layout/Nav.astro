---
/**
 * Primary nav — links only (the logo lives in Header.astro, the rail
 * chrome in SideNav.astro). This renders the list and nothing else, so
 * the same items can appear in a horizontal bar, a vertical rail, or a
 * footer without duplicating `site.ts`.
 *
 * The current page is worked out HERE, off `Astro.url`, rather than
 * being passed down from whatever renders the nav. Every caller would
 * otherwise have to thread the same value through for no reason: the
 * answer is a property of the request, identical for all of them, and
 * this is the only component that has the list of candidates to compare
 * it against.
 */
import { siteConfig } from '../../data/site';
import NavItem from './NavItem.astro';

interface Props {
  /**
   * `vertical` is what SideNav's rail and drawer use — items stretch to
   * the full column width. `horizontal` is a wrapping row for bar-style
   * placements.
   */
  orientation?: 'horizontal' | 'vertical';
}

const { orientation = 'horizontal' } = Astro.props;
const { nav } = siteConfig;

/* Trailing slash trimmed on both sides: Astro serves these routes as
   directories (`/faq/`) while the href in site.ts has no
   slash, and a raw `===` would then never match. */
const trim = (path: string) => path.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);

const layouts = {
  horizontal: 'flex flex-wrap items-center justify-center gap-1 rounded-card bg-paper-200 p-2',
  vertical: 'flex flex-col gap-1',
};
---

<nav aria-label="ניווט ראשי">
  <ul class={layouts[orientation]}>
    {
      nav.map((item) => (
        <li>
          <NavItem
            href={item.href}
            current={trim(item.href) === here}
            class={orientation === 'vertical' ? 'text-lg whitespace-normal' : ''}
          >
            {item.label}
          </NavItem>
        </li>
      ))
    }
  </ul>
</nav>
