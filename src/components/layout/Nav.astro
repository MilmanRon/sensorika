---
/**
 * Primary nav — links only (the logo lives in Header.astro, the rail
 * chrome in SideNav.astro). This renders the list and nothing else, so
 * the same items can appear in a horizontal bar, a vertical rail, or a
 * footer without duplicating `site.ts`.
 *
 * THE LANGUAGE SWITCHER IS THE FIRST ROW. It used to sit at the foot of
 * the drawer, under a rule, on the argument that it isn't a destination
 * and shouldn't lead a list of them. It reads as an afterthought down
 * there — and on a site whose whole point is that half its parents read
 * Russian, "am I in the right language" is the first question the nav
 * has to answer, not the last.
 *
 * It is rendered BESIDE <nav>, not inside its <ul>. That keeps the part
 * of the old arrangement that was right: the primary nav's list stays a
 * list of pages, so a screen reader hears a list of exactly the pages
 * and not one with a language control counted among them, and the
 * switcher keeps the landmark and the label of its own. All that moved is where it is and what it looks
 * like — `size="nav"` gives it NavItem's box, so it reads as row one.
 *
 * The current page is worked out HERE, off `Astro.url`, rather than
 * being passed down from whatever renders the nav. Every caller would
 * otherwise have to thread the same value through for no reason: the
 * answer is a property of the request, identical for all of them, and
 * this is the only component that has the list of candidates to compare
 * it against.
 */
import { currentLocale, ui } from '../../data/i18n';
import { getNavItems } from '../../data/site';
import LangSwitcher from './LangSwitcher.astro';
import NavItem from './NavItem.astro';

interface Props {
  /**
   * `vertical` is what SideNav's rail and drawer use — items stretch to
   * the full column width. `horizontal` is a wrapping row for bar-style
   * placements.
   */
  orientation?: 'horizontal' | 'vertical';
}

const { orientation = 'horizontal' } = Astro.props;

/* The locale is worked out here for the same reason the current page is:
   it's a property of the request, identical for every caller, and
   threading it down as a prop would just be one more thing a caller
   could forget. Same argument, one line lower. */
const locale = currentLocale(Astro);
const t = ui(locale);
const nav = await getNavItems(locale);

/* Trailing slash trimmed on both sides: Astro serves these routes as
   directories (`/faq/`) while the href in site.ts has no
   slash, and a raw `===` would then never match. */
const trim = (path: string) => path.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);

/* The switcher and the list are siblings, so the gap between them is the
   same gap that separates two links — which is what makes the switcher
   look like row one rather than like a block above the nav. */
const wrappers = {
  horizontal: 'flex flex-wrap items-center justify-center gap-1 rounded-card bg-paper-200 p-2',
  vertical: 'flex flex-col gap-1',
};

const layouts = {
  horizontal: 'flex flex-wrap items-center gap-1',
  vertical: 'flex flex-col gap-1',
};
---

<div class={wrappers[orientation]}>
  <LangSwitcher size={orientation === 'vertical' ? 'nav' : 'bar'} />

  <nav aria-label={t.primaryNav}>
    <ul class={layouts[orientation]}>
      {
        nav.map((item) => (
          <li>
            <NavItem
              href={item.href}
              current={trim(item.href) === here}
              class={orientation === 'vertical' ? 'text-lg whitespace-normal' : ''}
            >
              {item.label}
            </NavItem>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
