---
/**
 * THE LANGUAGE SWITCHER: עב | Рус, as one segmented control.
 *
 * A SEGMENTED CONTROL, NOT A DROPDOWN AND NOT A SINGLE TOGGLE. There are
 * exactly two languages and both names are two or three characters wide,
 * so the whole choice fits in the space a dropdown's trigger alone would
 * take — and it shows the reader what the other option IS rather than
 * making them open something to find out. A single "Рус" button would be
 * smaller still, but it hides which language you're currently in, which
 * is the one thing a reader who landed on the wrong one needs to see.
 *
 * NO FLAGS. A flag is a country, not a language: Hebrew is not the
 * Israeli flag (it's read by people who aren't in Israel) and Russian
 * emphatically isn't the Russian one (most of this clinic's Russian-
 * speaking parents are Israeli). The two-letter labels are also legible
 * at 12px in a way a 16px flag glyph is not.
 *
 * EACH LANGUAGE NAMES ITSELF, in its own script — "עב" and "Рус", not
 * "עברית / רוסית" in Hebrew and the reverse in Russian. A Russian
 * speaker who has landed on the Hebrew site can't read a Hebrew word for
 * "Russian"; a label in their own alphabet is the only one that works
 * for the person who most needs it. See `switchLabel` in i18n.ts for why
 * it's "Рус" and not the Latin "RU" or the transliterated "РУ".
 *
 * IT LINKS TO THE SAME PAGE, NOT TO HOME. `alternatePath()` swaps the
 * prefix and keeps the slug, so a parent halfway through the packages
 * page in Hebrew arrives at the packages page in Russian. Dropping them
 * on the home page instead is the single most common way a language
 * switcher is wrong, and it's worst exactly where it matters most — on
 * the long pages someone is actually reading.
 *
 * THE CURRENT LANGUAGE IS A `<span>`, NOT A LINK. It's marked
 * `aria-current="true"` and carries the white pill. Rendering it as an
 * <a> to the page you're already on gives a keyboard user a stop that
 * does nothing and a screen reader a link with no destination.
 *
 * IT IS `dir="ltr"` REGARDLESS OF THE PAGE. The pair reads עב-then-Рус
 * in both languages, so the control doesn't reorder itself when you use
 * it — which would be the one moment a reader is looking straight at it.
 *
 * That `dir` is on the <ul> and NOT on the outer <nav>, which is why the
 * two are separate elements at all in the `nav` size: the frame carries
 * `border-s-4`, and a logical border resolves against the direction of
 * the element it's written on. Hoisted onto the same node as `dir="ltr"`
 * it would draw the rule on the LEFT in Hebrew, where every row beside
 * it has one on the right.
 */
import { alternatePath, currentLocale, localeMeta, locales, ui } from '../../data/i18n';

interface Props {
  /**
   * `bar` is the header's: a compact tinted pill, sized to sit in the
   * inline nav row beside links that are bare text.
   *
   * `nav` is the drawer's, where the switcher is the first row of the
   * nav and has to READ as one. It borrows NavItem's box exactly —
   * `rounded-control`, `bg-paper-100`, a transparent `border-s-4` so
   * its labels line up with the labels of the rows below it — and drops
   * the tinted pill around the pair, because that box is now the
   * container. What survives is the white segment on the current
   * language, which is the same mark NavItem puts on the current page.
   */
  size?: 'bar' | 'nav';
  class?: string;
}

const { size = 'bar', class: className = '' } = Astro.props;

const locale = currentLocale(Astro);
const t = ui(locale);

/* The box around the control. `bar` has none: there, the pill below is
   the box. `nav` has NavItem's, so the row matches the ones under it. */
const frames = {
  bar: '',
  nav: 'rounded-control border-s-4 border-s-transparent bg-paper-100 p-2',
};

const lists = {
  bar: 'gap-0.5 rounded-pill bg-paper-200 p-0.5 text-xs ring-1 ring-ink-900/10',
  nav: 'gap-1 text-lg',
};

/* `nav`'s padding is NavItem's `px-5` less the segment's own `px-3`, so
   "עב" starts on the same vertical as "בית" one row down. */
const segment = {
  bar: 'min-w-8 px-2 py-1',
  nav: 'min-w-12 px-3 py-1',
};

/* The drawer rows fill the rail. Its language segments retain LTR order,
   so they need to be pushed to the far edge explicitly in an RTL page. */
const navAlignment = size === 'nav' && localeMeta[locale].dir === 'rtl' ? 'justify-end' : '';
const switcherLocales = size === 'nav' ? [...locales].reverse() : locales;
---

<nav aria-label={t.languageNav} class:list={[frames[size], className]}>
  <ul dir="ltr" class:list={['flex items-center', lists[size], navAlignment]}>
    {
      switcherLocales.map((other) => {
        const meta = localeMeta[other];
        const current = other === locale;
        const classes = [
          'block rounded-pill text-center font-semibold transition-colors duration-[var(--duration-fast)]',
          segment[size],
          current ? 'bg-white text-ink-900 shadow-card' : 'text-ink-600 hover:text-ink-900',
        ];

        return (
          <li>
            {current ? (
              <span aria-current="true" lang={meta.lang} class:list={classes}>
                {meta.switchLabel}
              </span>
            ) : (
              <a
                href={alternatePath(Astro.url.pathname, locale, other)}
                lang={meta.lang}
                hreflang={meta.lang}
                class:list={classes}
              >
                {/* The visible label is two letters; the accessible name
                    is the language's own name in its own language, so
                    "עב" isn't announced as an abbreviation nobody can
                    expand. */}
                <span class="sr-only">{meta.name}</span>
                <span aria-hidden="true">{meta.switchLabel}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
