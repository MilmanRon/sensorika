---
/**
 * THE HOME PAGE, whole: the chrome, the one section, and the floor.
 *
 * /playground/hero-method is where HeroMethod was reviewed — the section
 * on its own, under the proposed header, with ProgramsV2 under it to
 * show the hand-off. This is the finished page around it: same header,
 * same section, and a real footer closing it instead of a playground
 * back-link.
 *
 *   PageBackdrop   the ground. First in the slot and OUTSIDE <main>: one
 *                  fixed layer behind the header, the section and the
 *                  footer alike, not content of any of them.
 *   HeaderV2       white, sticky, shadowed.
 *   SideNav        the shipped drawer, untouched — HeaderV2 keeps
 *                  Header.astro's exact state contract, so the two pair
 *                  up as-is.
 *   HeroMethod     the greeting and the method, from home.md.
 *   ProgramsV2     the two tracks. It follows HeroMethod for the reason
 *                  HeroMethod ends without a CTA of its own: the section
 *                  closes on its takeaway line, and the first action a
 *                  visitor is offered is the one in Programs. That
 *                  hand-off is the whole argument for the combined hero,
 *                  and it only exists when the two are adjacent.
 *   SiteFooter     white and shadowed like the header: the two bars
 *                  bracket the document.
 *
 * NO OTHER SECTIONS. The nav's remaining anchors (מהו ויסות חושי, שאלות
 * נפוצות, …) are the pages still to be built; they are deliberately not
 * stacked onto this one.
 *
 * WHICH LEAVES `#contact` DANGLING. Programs' card CTAs, its closing
 * band and the footer's WhatsApp link all resolve there — the band and
 * the footer because `whatsappHref()` falls back to the anchor while
 * `contact.phone` is a TODO in site.ts. There is no contact section on
 * the page yet, so all four are inert. A number in site.ts fixes the
 * two that matter without touching a component.
 *
 * BaseLayout rather than SiteLayout, like every other proposed page
 * here: SiteLayout hardcodes the shipped Header.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideNav from '../../components/layout/SideNav.astro';
import HeaderV2 from './_proposed/HeaderV2.astro';
import HeroMethod from './_proposed/HeroMethod.astro';
import PageBackdrop from './_proposed/PageBackdrop.astro';
import ProgramsV2 from './_proposed/ProgramsV2.astro';
import SiteFooter from './_proposed/SiteFooter.astro';
---

<BaseLayout
  title="בית"
  description="מקום לילדים עם צרכים מיוחדים — אבחון וטיפול בוויסות חושי, עבודה פרטנית ופעילויות קבוצתיות התפתחותיות."
>
  <PageBackdrop />
  <HeaderV2 />
  <SideNav />

  <main id="main">
    <HeroMethod />
    <ProgramsV2 />
  </main>

  <SiteFooter />

  <!-- Playground chrome, after the footer: the only thing on this page
       that wouldn't ship. -->
  <div class="bg-white">
    <div
      class="mx-auto flex max-w-[var(--width-content)] flex-wrap gap-6 border-t border-ink-900/10 px-gutter py-6 lg:px-gutter-lg"
    >
      <a
        href="/playground"
        class="text-sm font-medium text-ink-600 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
      >
        ← כל הרכיבים
      </a>
      <a
        href="/playground/hero-method"
        class="text-sm text-ink-500 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
      >
        ↔ Hero + Method בבידוד
      </a>
    </div>
  </div>
</BaseLayout>
