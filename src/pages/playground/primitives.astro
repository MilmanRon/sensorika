---
/**
 * ui/ primitives, current against proposed. Button and Card had no
 * playground page of their own, which is part of why the contrast
 * defect in Button's two variants went unnoticed — it's only obvious
 * when every variant and size is on screen at once.
 */
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import ButtonV2 from './_proposed/ButtonV2.astro';
import CardV2 from './_proposed/CardV2.astro';
import Compare from './_proposed/Compare.astro';
import Icon from './_proposed/Icon.astro';

/* Card accents are ornament, so they're petal hues. Buttons are not,
   which is why every variant below is teal regardless of the card it
   sits in. */
const accents = ['coral', 'teal', 'amber', 'purple'] as const;

/**
 * Measured against white with the same oklch color-mix the tokens use.
 * The two failing rows are the shipped Button's only two variants.
 */
const contrast = [
  { pair: 'white on teal-700 (Button primary, current)', ratio: '5.92:1', pass: true },
  { pair: 'teal-700 on white (Button secondary, current)', ratio: '5.92:1', pass: true },
  { pair: 'white on teal-700 (ButtonV2 primary)', ratio: '5.92:1', pass: true },
  { pair: 'teal-800 on white (ButtonV2 ghost)', ratio: '9.28:1', pass: true },
  { pair: 'coral-800 on coral-100 (eyebrow pill)', ratio: '7.14:1', pass: true },
  { pair: 'amber-800 on amber-100 (eyebrow pill)', ratio: '5.11:1', pass: true },
  { pair: 'purple-800 on purple-100 (eyebrow pill)', ratio: '6.50:1', pass: true },
  { pair: 'white on coral-500 (a petal as a fill — never do this)', ratio: '3.03:1', pass: false },
];
---

<PlaygroundLayout title="ui/ primitives">
  <div class="flex flex-col gap-12">
    <section class="rounded-card bg-white p-6 shadow-card ring-1 ring-ink-900/10">
      <h2 class="font-display text-lg font-semibold text-ink-900">ניגודיות (WCAG AA — 4.5:1)</h2>
      <ul class="mt-4 flex flex-col gap-2 text-sm">
        {
          contrast.map((row) => (
            <li class="flex flex-wrap items-center gap-3">
              <span
                class:list={[
                  'rounded-pill px-2.5 py-0.5 font-display text-xs font-semibold',
                  row.pass ? 'bg-teal-100 text-teal-800' : 'bg-danger-500/15 text-danger-700',
                ]}
              >
                {row.pass ? 'עובר' : 'נכשל'}
              </span>
              <span dir="ltr" class="font-mono text-ink-700">
                {row.pair}
              </span>
              <span dir="ltr" class="text-ink-500">
                {row.ratio}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="flex flex-col gap-8">
      <h2 class="font-display text-xl font-semibold text-ink-900">Button</h2>

      <Compare side="current">
        <div class="flex flex-wrap items-center gap-4 bg-paper-50 p-8">
          <Button variant="primary">צרו קשר</Button>
          <Button variant="secondary">קצת עליי</Button>
          <Button variant="primary" size="sm">וואטסאפ</Button>
          <Button variant="secondary" size="sm">לפרטים</Button>
        </div>
      </Compare>

      <Compare
        side="proposed"
        notes={[
          'שני הווריאנטים הקיימים נכשלים בניגודיות — ראו הטבלה למעלה.',
          'רדיוס גלולה במקום rounded-control: פקד בגובה 48px ורדיוס 10px נקרא כשדה טופס, לא כ־CTA.',
          'secondary הוא משטח לבן עם טקסט דיו — היום שני הכפתורים באותו גוון אלמוגי ונקראים כפקד אחד שנחתך.',
          'צל במנוחה והרמה של 1px ב־hover, גודל lg ל־CTA של ההירו, וחץ אופציונלי שמתקדם לכיוון הקריאה.',
        ]}
      >
        <div class="flex flex-col gap-6 bg-paper-50 p-8">
          <div class="flex flex-wrap items-center gap-4">
            <ButtonV2 variant="primary" size="lg" arrow>צרו קשר</ButtonV2>
            <ButtonV2 variant="secondary" size="lg">קצת עליי</ButtonV2>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <ButtonV2 variant="primary">צרו קשר</ButtonV2>
            <ButtonV2 variant="secondary">קצת עליי</ButtonV2>
            <ButtonV2 variant="ghost" arrow>לפרטים נוספים</ButtonV2>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <ButtonV2 variant="primary" size="sm">וואטסאפ</ButtonV2>
            <ButtonV2 variant="secondary" size="sm">לפרטים</ButtonV2>
          </div>
        </div>
      </Compare>
    </div>

    <div class="flex flex-col gap-8">
      <h2 class="font-display text-xl font-semibold text-ink-900">Card</h2>

      <Compare side="current">
        <div class="grid gap-6 bg-paper-50 p-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            accents.map((accent) => (
              <Card accent={accent}>
                <h3 class="font-display text-lg font-semibold text-ink-900">כותרת כרטיס</h3>
                <p class="mt-3 leading-body text-ink-700">
                  גוף קצר שמסביר במשפט אחד מה הכרטיס הזה מציע.
                </p>
              </Card>
            ))
          }
        </div>
      </Compare>

      <Compare
        side="proposed"
        notes={[
          'האקסנט עובר מקו בקצה לאריח אייקון ולטבעת באותו גוון — קו של 4px לא יכול לשאת סמל, ורוב הקוראים לא ירשמו אותו.',
          'מצב hover (הרמה + הבהרת הטבעת) לכרטיס שהוא יעד. היום אין שום משוב עד שמגיעים לכפתור עצמו.',
          'עלה־כותרת דהוי בגוון האקסנט נחתך בפינה, כדי שכרטיס יהיה משטח ולא מלבן לבן.',
        ]}
      >
        <div class="grid gap-6 bg-paper-50 p-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            accents.map((accent) => (
              <CardV2 accent={accent} interactive>
                <span
                  class:list={[
                    'flex h-12 w-12 items-center justify-center rounded-card',
                    {
                      coral: 'bg-coral-100 text-coral-800',
                      teal: 'bg-teal-100 text-teal-800',
                      amber: 'bg-amber-100 text-amber-800',
                      purple: 'bg-purple-100 text-purple-800',
                    }[accent],
                  ]}
                >
                  <Icon name="sparkle" class="h-6 w-6" />
                </span>
                <h3 class="mt-5 font-display text-lg font-semibold text-ink-900">כותרת כרטיס</h3>
                <p class="mt-3 leading-body text-ink-700">
                  גוף קצר שמסביר במשפט אחד מה הכרטיס הזה מציע.
                </p>
              </CardV2>
            ))
          }
        </div>
      </Compare>
    </div>
  </div>
</PlaygroundLayout>
