---
/**
 * The combined Hero+Method proposal, shown under the proposed header
 * and above ProgramsV2 — the pairings matter. The section opens
 * directly beneath a sticky bar, and it ends on the closing line with
 * no CTA of its own, so the first action a visitor is offered is the
 * one in Programs. That hand-off is only visible in composition.
 *
 * Uses BaseLayout rather than PlaygroundLayout for the same reason
 * /playground/header does: HeaderV2 is `sticky top-0` and
 * PlaygroundLayout's own title bar sits at that offset, so it would
 * overlap the moment you scroll. The back link is inlined below instead.
 *
 * SideNav is the shipped component, untouched — HeaderV2 keeps
 * Header.astro's exact drawer contract, so the two pair up as-is.
 *
 * PageBackdrop is first in the slot and outside <main>: it's the ground
 * the whole page sits on, one fixed layer behind the header and the
 * sections alike, not content of any of them.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideNav from '../../components/layout/SideNav.astro';
import HeaderV2 from './_proposed/HeaderV2.astro';
import HeroMethod from './_proposed/HeroMethod.astro';
import PageBackdrop from './_proposed/PageBackdrop.astro';
import ProgramsV2 from './_proposed/ProgramsV2.astro';
---

<BaseLayout title="Hero + Method (combined) · Playground" description="Component playground">
  <PageBackdrop />
  <HeaderV2 />
  <SideNav />

  <main id="main">
    <HeroMethod />
    <ProgramsV2 />

    <div class="mx-auto flex max-w-[var(--width-content)] gap-6 px-gutter pb-16 lg:px-gutter-lg">
      <a
        href="/playground"
        class="text-sm font-medium text-ink-600 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
      >
        ← כל הרכיבים
      </a>
      <a
        href="/playground/home-v2"
        class="text-sm font-medium text-ink-600 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
      >
        ↔ להשוואה: Hero ו־Method בנפרד
      </a>
    </div>
  </main>
</BaseLayout>
