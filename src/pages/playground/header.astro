---
/**
 * Header + SideNav playground — the two are only meaningful together,
 * so they're exercised on one page.
 *
 * Uses BaseLayout rather than PlaygroundLayout: the header is
 * `sticky top-0` and PlaygroundLayout's own (non-sticky) title bar sits
 * at the same offset, so it would be overlapped the moment you scroll.
 * The back link is inlined into the content instead. It also doesn't use
 * SiteLayout, because SiteLayout supplies exactly the chrome under test.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import SideNav from '../../components/layout/SideNav.astro';
import { siteConfig } from '../../data/site';

const checks = [
  'גלילה למטה — הכותרת מקבלת רקע, גבול וצל.',
  'מתחת ל־sm — הלוגו נשאר עלי־כותרת בלבד וכפתור הוואטסאפ הופך לאייקון.',
  'בכל רוחב מסך — הניווט הוא מגירה נפתחת, וההמבורגר תמיד מוצג.',
  'עם מגירה פתוחה — הכותרת והמגירה באותו גוון, בלי צל ובלי תפר ביניהן.',
  'פתיחת המגירה נועלת גלילה; Esc סוגר ומחזיר פוקוס לכפתור.',
  'Tab במגירה פתוחה מסתובב בין כפתור הסגירה לפריטי הניווט בלבד.',
  'לחיצה על קישור או על הרקע המוצל סוגרת את המגירה.',
  'לחיצה על פריט ניווט גוללת לעוגן בלי להסתיר אותו מתחת לכותרת.',
  'Tab מהתחלה חושף את קישור הדילוג לתוכן.',
];
---

<BaseLayout title="Header + SideNav · Playground" description="Component playground">
  <Header />
  <SideNav />

  <main id="main" class="px-gutter py-12 lg:px-gutter-lg">
    <a
      href="/playground"
      class="text-sm font-medium text-ink-600 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
    >
      ← כל הרכיבים
    </a>

    <div class="mt-8 flex flex-col gap-4 text-sm text-ink-600">
      <p class="text-base font-semibold text-ink-900">מה לבדוק כאן</p>
      <ul class="flex list-disc flex-col gap-2 ps-5">
        {checks.map((check) => <li>{check}</li>)}
      </ul>
    </div>

    {
      siteConfig.nav.map((item) => (
        <section id={item.href.slice(1)}>
          <div class="mt-10 rounded-card bg-paper-100 p-8">
            <h2 class="font-display text-xl font-semibold text-ink-900">{item.label}</h2>
            <p class="mt-2 text-ink-600">מקטע דמה לבדיקת גלילה ועוגנים.</p>
          </div>
        </section>
      ))
    }

    <div class="h-[80vh]"></div>
  </main>
</BaseLayout>
