---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { playgroundEntries } from './_registry';

/* The nav-item pages come from the content collection rather than from
   the registry — they're one dynamic route over src/content/pages/, so
   the collection is already the list. */
const navPages = (await getCollection('pages', ({ data }) => data.nav)).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = ['pages', 'layout', 'ui', 'sections'] as const;
const groupLabels: Record<(typeof groups)[number], string> = {
  layout: 'layout/',
  ui: 'ui/',
  sections: 'sections/',
  pages: 'compositions',
};
---

<BaseLayout title="Playground" description="Component playground">
  <div class="mx-auto max-w-[var(--width-content)] px-gutter py-12 lg:px-gutter-lg">
    <h1 class="font-display text-3xl font-bold text-ink-900">Component playground</h1>
    <p class="mt-2 text-ink-600">
      Each component gets built and reviewed here on its own, before it's composed into a real
      page. Entries marked <span class="rounded-pill bg-teal-100 px-2 py-0.5 text-xs font-semibold text-teal-800">הצעה</span>
      render the shipped component and a proposed revision of it one above the other — see
      <code class="text-ink-700">src/pages/playground/_proposed/README.md</code>.
    </p>

    <section class="mt-10">
      <h2 class="font-display text-sm font-semibold tracking-wide text-ink-500 uppercase">
        nav-item pages
      </h2>
      <p class="mt-2 text-sm text-ink-600">
        One page per nav entry, each rendered by <code class="text-ink-700">[navpage].astro</code>
        out of a single <code class="text-ink-700">.md</code> file in
        <code class="text-ink-700">src/content/pages/</code> — copy changes are content edits.
      </p>
      <ul class="mt-3 flex flex-col divide-y divide-ink-900/10 rounded-card bg-paper-100">
        {navPages.map((page) => (
          <li>
            <a
              href={`/playground/${page.id}`}
              class="flex items-center justify-between gap-4 px-6 py-4 transition-colors duration-[var(--duration-fast)] hover:bg-paper-200"
            >
              <span class="font-medium text-ink-900">{page.data.navLabel ?? page.data.title}</span>
              <span class="text-sm text-ink-500">{page.id}.md</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {
      groups.map((group) => {
        const entries = playgroundEntries.filter((entry) => entry.group === group);
        if (entries.length === 0) return null;
        return (
          <section class="mt-10">
            <h2 class="font-display text-sm font-semibold tracking-wide text-ink-500 uppercase">
              {groupLabels[group]}
            </h2>
            <ul class="mt-3 flex flex-col divide-y divide-ink-900/10 rounded-card bg-paper-100">
              {entries.map((entry) => (
                <li>
                  <a
                    href={`/playground/${entry.slug}`}
                    class="flex items-center justify-between px-6 py-4 transition-colors duration-[var(--duration-fast)] hover:bg-paper-200"
                  >
                    <span class="flex items-center gap-3">
                      <span class="font-medium text-ink-900">{entry.title}</span>
                      {'compare' in entry && entry.compare && (
                        <span class="rounded-pill bg-teal-100 px-2 py-0.5 text-xs font-semibold text-teal-800">
                          הצעה
                        </span>
                      )}
                    </span>
                    <span class="text-sm text-ink-500">{entry.status}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
