---
/**
 * PROPOSED — copy of src/components/sections/Hero.astro. What changed:
 *
 * 1. THE PORTRAIT IS ANCHORED. It's a transparent cut-out, and today
 *    it's dropped onto empty cream with a `rounded-card` that clips
 *    nothing — so it reads as a stray PNG rather than as art direction.
 *    Both references frame their cut-out figure inside an organic shape.
 *    Here it sits in a petal-shaped well (--radius-blob) with a tinted
 *    gradient behind it and an offset ring outboard, so the silhouette
 *    has something to be cut *out of*.
 * 2. THE HEADLINE SAYS SOMETHING. "ברוכים הבאים ל-Sensorika" is the
 *    weakest possible h1: it's the greeting, not the offer. The offer
 *    was sitting one line below it in the subhead. This promotes it and
 *    demotes the greeting to the eyebrow. NOTE: no new copy — the words
 *    are the current hero's own, re-ranked. Needs a copy sign-off.
 * 3. A TRUST ROW. Both references put three icon+label chips directly
 *    under the CTAs. It's the cheapest way to answer "what actually
 *    happens here?" above the fold. The three labels are lifted from
 *    the existing Programs copy, not invented.
 * 4. The band is a real band — a teal wash fading into the page, with
 *    ornament (Decor) behind it and a wave joining it to what follows,
 *    instead of the current section's invisible dot mask.
 * 5. CTAs are `lg` pills with a arrow on the secondary, and the
 *    secondary is a white surface rather than a second filled control —
 *    on a one-hue palette two filled buttons would merge into one.
 *
 * Structure is otherwise the current one: copy column first in the DOM
 * (so it lands inline-start = right under RTL), portrait second.
 */
import { Image } from 'astro:assets';
import ButtonV2 from './ButtonV2.astro';
import Decor from './Decor.astro';
import Icon from './Icon.astro';
import WaveDivider from './WaveDivider.astro';
import heroPortrait from '../../../assets/hero/hero-portrait.png';

/**
 * Lifted verbatim from the two Programs cards and the current hero
 * subhead — deliberately not new claims about the clinic.
 */
const highlights = [
  { icon: 'clipboard', label: 'אבחון חושי-תפקודי', accent: 'coral' },
  { icon: 'user', label: 'מפגשים פרטניים', accent: 'purple' },
  { icon: 'users', label: 'קבוצות קטנות', accent: 'teal' },
] as const;

/* Icon tiles are ornament, so they get a petal each. The glyph is the
   -800 step on its own -100 tint, which clears 5:1 for all three. */
const tiles = {
  coral: 'bg-coral-100 text-coral-800',
  purple: 'bg-purple-100 text-purple-800',
  teal: 'bg-teal-100 text-teal-800',
};
---

<section class="relative isolate overflow-hidden bg-teal-50">
  <Decor variant="hero" />

  <div
    class="relative mx-auto grid max-w-[var(--width-content)] grid-cols-1 items-center gap-12 px-gutter pt-12 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-gutter-lg lg:pt-16 lg:pb-24"
  >
    <div class="flex flex-col items-start gap-6">
      <p
        class="inline-flex items-center gap-2 rounded-pill bg-white/80 px-4 py-1.5 font-display text-sm font-semibold text-teal-800 shadow-card ring-1 ring-teal-500/25 backdrop-blur-sm"
      >
        <Icon name="sparkle" class="h-4 w-4" />
        ברוכים הבאים ל-Sensorika
      </p>

      <h1
        class="font-display text-4xl leading-heading font-bold text-balance text-ink-900 sm:text-5xl"
      >
        {/*
          The accent lands on the verbs — they're the actual promise.
          teal-700, not the teal-500 base: the petal is 2.32:1, which
          would make the biggest words on the page the least legible
          ones. On this wash -700 is 5.68:1. The explicit {' '} is
          load-bearing: a JSX comment between two text nodes swallows
          the whitespace around it.
        */}
        מקום לילדים עם צרכים מיוחדים{' '}
        <span class="text-teal-700">לשחק, להתנסות ולגדול</span>
      </h1>

      <p class="max-w-lg text-lg leading-body text-pretty text-ink-700">
        חוג שבועי לפי גיל ורמה, וספרייה של תוכן מקצועי להורים.
      </p>

      <div class="mt-2 flex flex-wrap items-center gap-4">
        <ButtonV2 href="#contact" variant="primary" size="lg" arrow>צרו קשר</ButtonV2>
        <ButtonV2 href="#about" variant="secondary" size="lg">קצת עליי</ButtonV2>
      </div>

      <!-- Trust row. `ul`, not a div of spans — it is a list, and a
           screen-reader user should hear how many items are in it. -->
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          highlights.map((item) => (
            <li class="flex items-center gap-2.5 rounded-pill bg-white/80 py-1.5 ps-1.5 pe-4 shadow-card ring-1 ring-ink-900/5 backdrop-blur-sm">
              <span
                class:list={[
                  'flex h-8 w-8 shrink-0 items-center justify-center rounded-pill',
                  tiles[item.accent],
                ]}
              >
                <Icon name={item.icon} class="h-4 w-4" />
              </span>
              <span class="text-sm font-medium text-ink-800">{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- The portrait's frame. `figure` rather than a bare div: it is the
         page's one photograph, not an icon. -->
    <figure class="relative mx-auto w-full max-w-md lg:max-w-none">
      <span class="frame-ring" aria-hidden="true"></span>
      <div class="frame">
        <Image
          src={heroPortrait}
          alt="TODO: תיאור נגיש לתמונה"
          width={760}
          class="portrait"
          loading="eager"
        />
      </div>
      <span class="dot dot-amber" aria-hidden="true"></span>
      <span class="dot dot-purple" aria-hidden="true"></span>
    </figure>
  </div>

  <!--
    One crest, painted in the colour of the band that follows (Method's
    teal-100). Two adjacent dividers — one closing this section, one
    opening the next — read as a ripple, not as a join.
  -->
  <WaveDivider fill="teal-100" class="relative -mb-px" />
</section>

<style>
  /* The petal-shaped well the cut-out sits in. `overflow: hidden` is the
     point: the portrait's straight-cut bottom edge is hidden by the
     shape, so the figure reads as emerging from it. */
  .frame {
    position: relative;
    border-radius: var(--radius-blob);
    overflow: hidden;
    /* Runs between two petals, which is what gives the well its depth.
       Both are mixed toward white so the cut-out figure stays the
       highest-contrast thing inside the shape. */
    background: linear-gradient(
      170deg,
      color-mix(in oklch, var(--color-teal-500) 55%, white),
      color-mix(in oklch, var(--color-amber-500) 35%, white)
    );
    aspect-ratio: 1 / 1.08;
  }

  .portrait {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Head near the top of the well; `cover` alone would centre the
       torso and crop the face. */
    object-position: 50% 8%;
  }

  /* An outboard stroke on the alternate petal, rotated off the frame so
     the two silhouettes don't trace each other. */
  .frame-ring {
    position: absolute;
    inset: -1.25rem;
    border-radius: var(--radius-blob-alt);
    border: 3px solid color-mix(in oklch, var(--color-coral-500) 35%, transparent);
    transform: rotate(-8deg);
  }

  .dot {
    position: absolute;
    display: block;
    border-radius: var(--radius-pill);
  }
  /* Two loose dots in the petals the well itself doesn't use, so they
     separate from it and from each other. */
  .dot-amber {
    inset-block-start: -0.5rem;
    inset-inline-start: 12%;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-amber-500);
  }
  .dot-purple {
    inset-block-end: 8%;
    inset-inline-end: -0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-purple-300);
  }
</style>
