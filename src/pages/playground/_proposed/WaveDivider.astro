---
/**
 * PROPOSED (new — no current counterpart).
 *
 * The page today is one flat field from the header to the footer:
 * three sections separated by nothing but vertical padding. Both
 * reference designs band their page into tinted zones and join the
 * bands with a soft organic edge rather than a straight line — which is
 * the single biggest reason they read as designed rather than as a
 * document.
 *
 * This is that join: a soft crest that paints the *next* section's color
 * over the bottom of the current one. Purely decorative, so it's
 * aria-hidden and carries no content.
 */
interface Props {
  /**
   * Fill — should match the background of the section that follows.
   * Section grounds are white or a -50/-100 wash; a band never takes a
   * petal at full strength.
   */
  fill?: 'white' | 'teal-50' | 'teal-100' | 'coral-50' | 'amber-50' | 'purple-50';
  /** `up` crests upward (default), `down` dips into the section below. */
  direction?: 'up' | 'down';
  class?: string;
}

const { fill = 'teal-50', direction = 'up', class: className = '' } = Astro.props;

const fills = {
  white: 'text-white',
  'teal-50': 'text-teal-50',
  'teal-100': 'text-teal-100',
  'coral-50': 'text-coral-50',
  'amber-50': 'text-amber-50',
  'purple-50': 'text-purple-50',
};
---

<div
  class:list={['pointer-events-none w-full', fills[fill], className]}
  aria-hidden="true"
>
  <svg
    class:list={['block h-[3.5rem] w-full sm:h-[5.5rem]', direction === 'down' && 'rotate-180']}
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <!--
      Crest amplitude is ~48% of the viewBox height. The first pass used
      ~25% and at 1440px wide it read as a straight line with a dent in
      it — a divider this shallow costs a DOM node and buys nothing.
    -->
    <path
      d="M0 120V44C96 10 210 -2 342 20 474 42 578 78 726 78 874 78 994 38 1126 22 1234 9 1340 16 1440 42V120Z"
    ></path>
  </svg>
</div>
