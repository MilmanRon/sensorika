---
/**
 * PROPOSED (new — no current counterpart).
 *
 * The shared body of a nav-item page: intro band + a stack of accented
 * ProsePanels + (on the FAQ) an accordion. Everything a page differs in
 * — its title, its opening line, how its copy splits into panels — comes
 * from one .md file in the `pages` collection, so a copy change is a
 * content edit and never a component edit.
 *
 * This started as SensoryRegulation.astro, which was that page's copy
 * and its layout in one file. It's generalized here because there are
 * six of these pages and they're all the same shape: what changes per
 * page is the words.
 *
 * ACCENTS cycle coral → teal → purple → amber down the page, so a reader
 * scrolling a long explanatory page can tell one panel from the next
 * without reading it. A panel can name its own hue, but nothing does
 * yet — the cycle is the point. The hues carry no meaning; they're
 * wayfinding, and they're ornament: the panel's own links and buttons
 * stay teal like everything else on the site.
 *
 * DECORATION happens exactly once, in the intro band behind the h1 — the
 * hero's `Decor`, but the petals only (`dots={false}`). The dot grid
 * works under the hero, where it's the ground a whole band sits on; in a
 * short band it's a fine repeating pattern crowding the title. The
 * panels themselves are clean (ProsePanel turns CardV2's corner petal
 * off). The rule these pages settled: the ornament belongs to the PAGE,
 * not to each card — repeated down a stack the corner blob became a tile
 * you notice instead of a flourish you don't.
 */
import type { CollectionEntry } from 'astro:content';

import Decor from './Decor.astro';
import FaqList from './FaqList.astro';
import ProsePanel from './ProsePanel.astro';

interface Props {
  /** A `pages` collection entry's frontmatter. */
  page: CollectionEntry<'pages'>['data'];
  /**
   * The section's `id`, so the shipped nav's same-page anchors still
   * land somewhere while these are playground routes rather than the
   * real pages. Drops out once the nav hrefs become paths.
   */
  anchor?: string;
}

const { page, anchor } = Astro.props;

/* Wayfinding order, not a palette: see the note above. */
const cycle = ['coral', 'teal', 'purple', 'amber'] as const;

/* The bullet of a labelled list, tinted to the panel's own accent.
   A real `list-disc` marker rather than a positioned span: the browser
   puts it on the correct side under dir="rtl" and aligns it with the
   item's first line on its own, with no hand-tuned offset to keep in
   sync with the type scale. */
const markers = {
  coral: 'marker:text-coral-500',
  teal: 'marker:text-teal-500',
  amber: 'marker:text-amber-500',
  purple: 'marker:text-purple-500',
};

/* Numbered badge — the same pairing as the panel's eyebrow pill, which
   is what makes the accent legible at this size. */
const badges = {
  coral: 'bg-coral-100 text-coral-800',
  teal: 'bg-teal-100 text-teal-800',
  amber: 'bg-amber-100 text-amber-800',
  purple: 'bg-purple-100 text-purple-800',
};
---

<section id={anchor} class="py-section lg:py-section-lg">
  <div class="mx-auto max-w-[var(--width-content)] px-gutter lg:px-gutter-lg">
    <!--
      The intro band: title, opening line, and the page's only ornament.
      `isolate` + `-z-10` keeps Decor behind the text without it needing
      a z-index of its own, and the generous `pb-*` is what gives the
      petals room — Decor is `inset-0` on this box and clips to it, so a
      band sized tight to two lines of text would shear them in half.
      That padding is also the gap down to the first panel, which is why
      the stack below carries no top margin.
    -->
    <div class="relative isolate pt-2 pb-14 lg:pb-20">
      <Decor variant="hero" dots={false} class="-z-10" />

      <!-- One size step below the home page's h1 (no lg:text-6xl): an
           interior page shouldn't shout as loud as the greeting does. -->
      <h1
        class="text-center font-display text-4xl leading-heading font-bold text-balance text-ink-900 sm:text-5xl"
      >
        {page.title}
      </h1>

      {
        page.intro && (
          <p class="mx-auto mt-6 max-w-[var(--width-prose)] text-center text-lg leading-body text-pretty text-ink-700 sm:text-xl">
            {page.intro}
          </p>
        )
      }
    </div>

    {
      page.panels.length > 0 && (
        <div class="flex flex-col gap-8 lg:gap-10">
          {page.panels.map((panel, i) => {
            const accent = panel.accent ?? cycle[i % cycle.length];
            return (
              <ProsePanel
                accent={accent}
                eyebrow={panel.eyebrow}
                heading={panel.heading}
                lead={panel.lead}
                pullout={panel.pullout}
              >
                {panel.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}

                {/*
                  Two list shapes, because the copy has two.

                  NUMBERED — the four individual-work formats. The number
                  is the clinic's own, the name is a title, so it gets its
                  own line above its description.

                  PLAIN — "ויסות ורמת הפעילות. הילד נמצא כל הזמן
                  בתנועה…". The source writes these as a bold lead-in
                  followed by the sentence it introduces, so the term
                  stays inline; pulling it onto its own line would turn
                  eight sentences into sixteen.
                */}
                {panel.items &&
                  (panel.numbered ? (
                    <ol class="mt-2 flex flex-col gap-6">
                      {panel.items.map((item, n) => (
                        <li class="flex gap-4">
                          <span
                            class:list={[
                              'mt-1 flex size-8 shrink-0 items-center justify-center rounded-pill font-display text-sm font-semibold',
                              badges[accent],
                            ]}
                            aria-hidden="true"
                          >
                            {n + 1}
                          </span>
                          <div>
                            {item.term && (
                              <p class="font-display leading-heading font-semibold text-ink-900">
                                {item.term}
                              </p>
                            )}
                            <p class:list={[item.term && 'mt-1']}>{item.text}</p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <ul class:list={['mt-2 list-disc space-y-4 ps-6', markers[accent]]}>
                      {panel.items.map((item) => (
                        <li>
                          {item.term && (
                            <strong class="font-display font-semibold text-ink-900">
                              {item.term}{' '}
                            </strong>
                          )}
                          {item.text}
                        </li>
                      ))}
                    </ul>
                  ))}

                {panel.note && <p class="text-ink-600">{panel.note}</p>}
              </ProsePanel>
            );
          })}
        </div>
      )
    }

    {page.faq.length > 0 && <FaqList items={page.faq} />}
  </div>
</section>
