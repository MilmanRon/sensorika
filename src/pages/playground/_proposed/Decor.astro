---
/**
 * PROPOSED (new — no current counterpart).
 *
 * Scattered background ornament: soft petal shapes in the four logo
 * hues, plus the dot grid. The current hero has the dot grid
 * only, at 50% opacity behind a mask, which is close to invisible — so
 * the cut-out portrait floats on an empty field with nothing behind it
 * to sit against.
 *
 * Everything here is decoration: `aria-hidden`, `pointer-events-none`,
 * and absolutely positioned inside a `relative` parent.
 *
 * MOTION: the petals drift on scroll — a parallax, scrubbed to scroll
 * position rather than played, so nothing moves unless the reader moves
 * it. Amplitude is deliberately tiny (see the script); what you read is
 * the petals lagging behind the type they sit under, not the petals
 * travelling. Under `prefers-reduced-motion` the whole thing is never
 * built and the shapes stay exactly where the CSS puts them.
 */
interface Props {
  /** Which ornaments to draw. */
  variant?: 'hero' | 'quiet';
  /**
   * The dot grid. On the hero it's the texture the whole band sits on,
   * but behind a short intro band it's a small repeating pattern next to
   * a lot of type, which reads as noise rather than as ground — so a
   * page that wants the petals alone turns it off. (`quiet` is the dot
   * grid, so `variant="quiet"` with `dots={false}` draws nothing.)
   */
  dots?: boolean;
  class?: string;
}

const { variant = 'hero', dots = true, class: className = '' } = Astro.props;
---

<div
  class:list={['decor pointer-events-none absolute inset-0 overflow-hidden', className]}
  data-decor
  aria-hidden="true"
>
  {dots && <span class="dots" />}

  {
    variant === 'hero' && (
      <>
        {/* One shape per logo hue, at the -300 tint rather than the
            -500 base. These sit behind a whole band of type, and a
            full-strength petal at this size stops being a ground and
            starts being a thing on the page. */}
        <span class="petal petal-a bg-amber-300/70" data-petal />
        <span class="petal petal-b bg-purple-300/70" data-petal />
        <span class="petal petal-c bg-teal-300/70" data-petal />
        <span class="petal petal-d bg-coral-300/70" data-petal />
      </>
    )
  }
</div>

<style>
  /* Same offset checker as the current hero, but denser and unmasked —
     it's now a texture the whole band sits on rather than a fade behind
     one column. Four passes, one per logo hue, each a quarter-step
     along the cell so the colors rotate instead of pairing up. */
  .dots {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, var(--color-coral-300) 1.5px, transparent 1.5px),
      radial-gradient(circle, var(--color-teal-300) 1.5px, transparent 1.5px),
      radial-gradient(circle, var(--color-amber-300) 1.5px, transparent 1.5px),
      radial-gradient(circle, var(--color-purple-300) 1.5px, transparent 1.5px);
    background-size: 26px 26px;
    background-position: 0 0, 13px 13px, 13px 0, 0 13px;
    mask-image: radial-gradient(120% 90% at 50% 0%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, black 20%, transparent 75%);
  }

  .petal {
    position: absolute;
    display: block;
    border-radius: var(--radius-blob);
    filter: blur(0.5px);
    /* These four are the only things on the page animated on scroll;
       promoting them is the point of the hint, and there are never more
       than four per Decor. */
    will-change: transform;
  }

  /* Placed physically (top/left), not logically: these are ornaments in
     a composition, so they should stay put when the document flips to
     LTR for the Russian locale rather than mirroring with the text. */
  .petal-a {
    top: 12%;
    left: 6%;
    width: 5.5rem;
    height: 5.5rem;
  }
  .petal-b {
    top: 62%;
    left: 2%;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-blob-alt);
  }
  .petal-c {
    top: 8%;
    right: 8%;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-blob-alt);
  }
  .petal-d {
    top: 74%;
    right: 4%;
    width: 6.5rem;
    height: 6.5rem;
  }

  @media (width < 64rem) {
    .petal-b,
    .petal-d {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /**
   * Scroll parallax for the petals: each drifts against the page at its
   * own rate and turns a few degrees while it does, so the ornament
   * feels like it sits at a different depth from the type in front of
   * it.
   *
   * `scrub`, not `toggleActions`. A parallax has to be tied to scroll
   * POSITION — the reader is the one moving it, and it stops the moment
   * they stop. A played tween would be an animation that happens to be
   * fired by scrolling, which is a different (and much noisier) thing.
   * The 0.6 gives the petals a beat of lag catching up to the scroll,
   * which is most of what sells the depth.
   *
   * AMPLITUDES ARE SMALL ON PURPOSE, and not only for calm: `.decor` is
   * `overflow-hidden`, so a petal that travels far enough to cross the
   * band's edge gets sheared off along an invisible straight line. The
   * numbers below are each under ~25px of real travel, which keeps every
   * shape on the same side of the edge it starts on. Petals b and d
   * already bleed past the bottom when static, so they drift downward —
   * further out the way they were already going, never back in and then
   * out again.
   *
   * `yPercent` rather than `y`: it's a transform (no layout, per the
   * performance skill) and it's relative to each petal's own size, so
   * the same number means the same visual proportion on a 3.5rem shape
   * and a 6.5rem one.
   */
  const DRIFT = [-28, 40, -28, 24];
  const SPIN = [9, -12, 7, -9];

  /* matchMedia, not a one-off query: it reverts every tween and kills
     every ScrollTrigger created in here if the reader turns reduced
     motion on while the page is open. */
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    /* One Decor per section, and a page can hold several (the nav-item
       pages stack panels). Document order, so the ScrollTriggers are
       created top-to-bottom down the page and refresh in that order
       without needing `refreshPriority`. */
    gsap.utils.toArray<HTMLElement>('[data-decor]').forEach((field) => {
      const petals = gsap.utils.toArray<HTMLElement>('[data-petal]', field);
      if (!petals.length) return;

      /* One tween for the group with function-based values, rather than
         a tween per petal: four targets, four ScrollTriggers' worth of
         work done by one. */
      gsap.to(petals, {
        yPercent: (i: number) => DRIFT[i % DRIFT.length],
        rotation: (i: number) => SPIN[i % SPIN.length],
        /* Linear, always. Any other ease would put the petals somewhere
           other than where the scroll position says they are. */
        ease: 'none',
        scrollTrigger: {
          trigger: field,
          /* clamp() keeps the range inside the page's own bounds. It
             matters here: the hero's Decor sits at the very top, so an
             unclamped "top bottom" start would already be behind us at
             load and the petals would render pre-drifted before the
             reader has scrolled a pixel. Clamped, progress is 0 at
             scroll 0 and the shapes sit exactly where the CSS put them. */
          start: 'clamp(top bottom)',
          end: 'clamp(bottom top)',
          scrub: 0.6,
        },
      });
    });
  });
</script>
