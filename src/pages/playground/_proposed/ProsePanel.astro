---
/**
 * PROPOSED (new — no current counterpart).
 *
 * The "method panel" extracted so it can be reused. HeroMethod.astro
 * introduced the shape and it's the one that landed: a CardV2 on the
 * page's plain paper ground, spanning --width-content, with a tinted
 * eyebrow pill, a heading, body copy set on --width-prose inside it,
 * and an optional pulled-out takeaway line on an inline-start rule.
 *
 * It's factored out here because every nav item is getting a page built
 * out of these — a stack of panels is what an explanatory page *is* in
 * this design — and repeating the utility strings on each one is how
 * they'd quietly drift apart.
 *
 * The panel is what goes full width; the copy inside it still gets a
 * reading measure. Four paragraphs across 72rem run past 100 characters
 * a line, and these are pages a parent actually has to read.
 *
 * ONE DELIBERATE DIFFERENCE from HeroMethod's panel: CardV2's decorative
 * corner petal is OFF here by default. HeroMethod shows a single panel,
 * where the shape is a flourish; a nav-item page stacks four or more,
 * and the same blob at the same corner of every one reads as wallpaper
 * rather than as decoration. The ornament moves up to the page's intro
 * band instead (see SensoryRegulation), so it happens once. What still
 * tells the panels apart is the accent ring and the eyebrow pill, which
 * is what they were for. Pass `petal` to bring it back on a panel that
 * stands alone.
 *
 * `accent` keeps CardV2's contract — a petal-hue name, never a raw
 * color — so a lookup can only ever resolve to a token.
 *
 * HeroMethod.astro is deliberately NOT refactored onto this: it's the
 * version under review, and rewriting it would invalidate the
 * comparison. Fold it in once the direction is signed off.
 */
import CardV2 from './CardV2.astro';

interface Props {
  /** Small label naming the panel. Omit for a panel that opens cold. */
  eyebrow?: string;
  /** Petal hue for the ring, the corner wash, the pill and the rule. */
  accent?: 'coral' | 'teal' | 'amber' | 'purple';
  /** The panel's headline. */
  heading?: string;
  /**
   * The heading's level. `h2` on a page whose panels ARE its sections —
   * every explanatory page today. `h3` for a stack that already sits
   * under a heading of its own (the packages page's terms), so the
   * outline doesn't put a panel level with the block containing it.
   */
  headingAs?: 'h2' | 'h3';
  /**
   * Opening sentence, set larger than the body — Method.astro's `lead`.
   * Use it instead of `heading` for a panel whose own first sentence is
   * a full definition rather than a headline: 150 characters set bold at
   * text-3xl is four lines of shouting, and the copy shouldn't be cut
   * down to fit a heading it was never written as.
   */
  lead?: string;
  /** Takeaway line, pulled out under the body on its own rule. */
  pullout?: string;
  /** CardV2's corner wash. Off by default — panels stack, see above. */
  petal?: boolean;
  class?: string;
}

const {
  eyebrow,
  accent = 'coral',
  heading,
  headingAs: Heading = 'h2',
  lead,
  pullout,
  petal = false,
  class: className = '',
} = Astro.props;

/* Tinted pill, not colored text: at 14px a petal base is nowhere near
   4.5:1 on white, but the -800 step on its own -100 tint clears 5:1 —
   the tile is what makes the hue usable. Same table as SectionHeading. */
const eyebrows = {
  coral: 'bg-coral-100 text-coral-800',
  teal: 'bg-teal-100 text-teal-800',
  amber: 'bg-amber-100 text-amber-800',
  purple: 'bg-purple-100 text-purple-800',
};

/* The rule is a shape, not type, so it takes the -500 base. */
const rules = {
  coral: 'border-s-coral-500',
  teal: 'border-s-teal-500',
  amber: 'border-s-amber-500',
  purple: 'border-s-purple-500',
};
---

<!-- `sm:p-*` / `lg:p-*` rather than a bare `p-*`: CardV2's base sets
     `p-8`, and only a variant utility reliably overrides it. -->
<CardV2 accent={accent} petal={petal} class:list={['sm:p-12 lg:p-16', className]}>
  <div class="mx-auto max-w-[var(--width-prose)]">
    {
      eyebrow && (
        <p
          class:list={[
            'inline-flex items-center rounded-pill px-4 py-1.5 font-display text-sm font-semibold',
            eyebrows[accent],
          ]}
        >
          {eyebrow}
        </p>
      )
    }

    {
      heading && (
        /* Capitalized, so Astro reads it as the tag name in `headingAs`
           rather than as a literal <Heading> element. The type scale is
           the panel's, not the level's: an h3 here is still the biggest
           thing in its card. */
        <Heading
          class:list={[
            'font-display text-2xl leading-heading font-bold text-balance text-ink-900 sm:text-3xl',
            eyebrow && 'mt-5',
          ]}
        >
          {heading}
        </Heading>
      )
    }

    {
      lead && (
        <p
          class:list={[
            'text-xl leading-body font-medium text-pretty text-ink-800',
            eyebrow && 'mt-5',
          ]}
        >
          {lead}
        </p>
      )
    }

    <!-- Body styles live on the wrapper so the caller can drop in
         <p>/<ul> without restating the type scale on each one. -->
    <div
      class:list={[
        'flex flex-col gap-4 text-lg leading-body text-pretty text-ink-800',
        (eyebrow || heading || lead) && 'mt-6',
      ]}
    >
      <slot />
    </div>

    {
      pullout && (
        <p
          class:list={[
            'mt-8 border-s-4 ps-5 font-display text-lg leading-body font-semibold text-ink-900 sm:text-xl',
            /* `border-s` is logical, so the rule lands on the right
               under dir=rtl without a direction-specific override. */
            rules[accent],
          ]}
        >
          {pullout}
        </p>
      )
    }
  </div>
</CardV2>
