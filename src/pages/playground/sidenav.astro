---
/**
 * SideNav's contents on their own. The drawer needs Header's trigger to
 * open, so the working drawer lives on /playground/header — this page is
 * just the panel's item rendering, at the width the drawer gives it.
 */
import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
import Nav from '../../components/layout/Nav.astro';
---

<PlaygroundLayout title="SideNav">
  <div class="flex flex-col gap-8">
    <section>
      <p class="mb-3 text-sm text-ink-500">
        תוכן המגירה (Nav במצב vertical), ברוחב האמיתי שלה
      </p>
      <div class="w-rail rounded-card border border-ink-900/10 bg-paper-50 p-3">
        <Nav orientation="vertical" />
      </div>
    </section>

    <section>
      <p class="mb-3 text-sm text-ink-500">
        המגירה המלאה נבדקת ב־<a class="underline" href="/playground/header">/playground/header</a>
      </p>
    </section>
  </div>
</PlaygroundLayout>
