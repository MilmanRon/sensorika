---
/**
 * Every nav-item page, from the `pages` content collection: one route
 * instead of one .astro file per nav entry, because the pages differ
 * only in their copy and that copy now lives in src/content/pages/.
 *
 * This replaces the hand-written /playground/sensory-regulation route.
 * Astro matches static routes before dynamic ones, so the other
 * playground pages (index, hero, method, …) still win over this file —
 * but that also means a content slug colliding with one of them would
 * be silently unreachable. The six slugs here match the anchors in
 * site.ts, which is what they'd become as real routes anyway.
 *
 * These stay under /playground for now rather than shipping at /faq,
 * /about, … because they're built out of _proposed/: promoting them
 * means promoting CardV2 and proposed-tokens.css first. `pagesBase` in
 * site.ts is the one place that says so, and it's what every nav href
 * and the lockup's home link are built from — so the move is an edit
 * there, not a search for hardcoded paths here.
 *
 * THE PAGE IS ASSEMBLED LIKE /playground/full-page, and for the same
 * reasons — these are the home page's siblings, not a different kind of
 * document, so they get the same ground and the same floor:
 *
 *   PageBackdrop   first in the slot and OUTSIDE <main>: one fixed
 *                  layer — wash, drifting petal field, dither — behind
 *                  the header, the panels and the footer alike, not
 *                  content of any of them. It's also what the panels
 *                  lift off: ProsePanel is a white CardV2 and a stack
 *                  of them on flat white is white on white.
 *   HeaderV2 +
 *   SideNav        the chrome, and now the way BETWEEN these pages: the
 *                  nav's six entries are these six routes, and the one
 *                  you're on is marked. Nothing here has to render a
 *                  list of the others any more.
 *   ProsePage      the page's own copy.
 *   SiteFooter     the floor. It comes with the backdrop rather than as
 *                  a separate nicety: the fixed ground has no bottom
 *                  edge of its own, so without a solid band the last
 *                  panel just stops.
 *
 * ProsePage's intro band used to draw its own <Decor> petals; it no
 * longer does, since the backdrop's field covers the same band — see
 * the note there.
 *
 * BaseLayout rather than PlaygroundLayout for the same reason
 * /playground/header uses it: HeaderV2 is `sticky top-0` and
 * PlaygroundLayout's own title bar sits at that offset, so the two would
 * overlap on scroll. The one back-link is inlined below instead — after
 * the footer, like full-page's, since the footer now ends the document.
 */
import { getCollection } from 'astro:content';

import SideNav from '../../components/layout/SideNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';
import HeaderV2 from './_proposed/HeaderV2.astro';
import PageBackdrop from './_proposed/PageBackdrop.astro';
import ProsePage from './_proposed/ProsePage.astro';
import SiteFooter from './_proposed/SiteFooter.astro';

export async function getStaticPaths() {
  /* `nav: false` entries (the home page's copy) live in the same
     collection but are rendered by their own section, not by this route. */
  const pages = (await getCollection('pages', ({ data }) => data.nav)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  /* The nav in site.ts names these pages by slug, and every one of those
     names has to resolve to a file here or the header renders a link to
     a 404. Two lists that must agree, in two places that can't see each
     other — so the build says so rather than the browser. */
  const built = new Set(pages.map((page) => page.id));
  const missing = siteConfig.nav.filter((item) => !built.has(item.slug));
  if (missing.length > 0) {
    throw new Error(
      `site.ts nav points at ${missing.map((item) => `"${item.slug}"`).join(', ')}, ` +
        'which has no matching file in src/content/pages/ (or its frontmatter sets nav: false).',
    );
  }

  return pages.map((entry) => ({ params: { navpage: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.title} · Playground`} description={entry.data.description}>
  <PageBackdrop />
  <HeaderV2 />
  <SideNav />

  <main id="main">
    <ProsePage page={entry.data} />
  </main>

  <SiteFooter />

  <!-- Playground chrome, after the footer: the only thing on this page
       that wouldn't ship. It used to also list the five other nav pages,
       which was the only way to walk between them; the header's nav is
       that now, so all that's left is the way back out. -->
  <div class="bg-white">
    <div
      class="mx-auto flex max-w-[var(--width-content)] flex-wrap gap-6 border-t border-ink-900/10 px-gutter py-6 lg:px-gutter-lg"
    >
      <a
        href="/playground"
        class="text-sm font-medium text-ink-600 transition-colors duration-[var(--duration-fast)] hover:text-ink-900"
      >
        ← כל הרכיבים
      </a>
    </div>
  </div>
</BaseLayout>
