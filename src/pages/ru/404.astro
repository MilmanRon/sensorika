---
/**
 * The not-found page, Russian.
 *
 * IT IS NOT CURRENTLY SERVED FOR BAD URLS. It was added expecting
 * Cloudflare's "404-page" handling to reach for the nearest 404.html and
 * find this one for a mistyped path under /ru; the deployed site says
 * otherwise — the root /404.html is served for everything. See
 * src/pages/404.astro for the confirmation and for what fixing it would
 * cost.
 *
 * It stays, for two reasons: it is a correct Russian page at a real URL
 * (/ru/404) that can be linked to, and it is the half of the pair that
 * already exists if the site ever does grow the worker that would route
 * to it. Deleting it would mean writing it again.
 *
 * See NotFound.astro for why `locale` is a prop here rather than
 * something derived.
 *
 * A static route rather than another `[...locale]` branch, because
 * `src/pages/404.astro` is special-cased by Astro (the dev server serves
 * it for unmatched paths) and a dynamic route producing `/404` would
 * emit the right file while losing that. Two small files beat one clever
 * one for something that only ever renders when everything else failed.
 */
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import PageBackdrop from '../../components/layout/PageBackdrop.astro';
import SideNav from '../../components/layout/SideNav.astro';
import NotFound from '../../components/sections/NotFound.astro';
import { ui } from '../../data/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const t = ui('ru');
---

<BaseLayout title={t.notFoundTitle} description={t.notFoundDescription}>
  <PageBackdrop />
  <Header />
  <SideNav />

  <main id="main">
    <NotFound locale="ru" />
  </main>

  <Footer />
</BaseLayout>
