---
/**
 * The not-found page, Russian — emitted at /ru/404.html so Cloudflare
 * has a Russian one to reach for on a bad URL under /ru. See
 * src/pages/404.astro for the whole argument, and NotFound.astro for why
 * `locale` is a prop here rather than something derived.
 *
 * A static route rather than another `[...locale]` branch, because
 * `src/pages/404.astro` is special-cased by Astro (the dev server serves
 * it for unmatched paths) and a dynamic route producing `/404` would
 * emit the right file while losing that. Two small files beat one clever
 * one for something that only ever renders when everything else failed.
 */
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import PageBackdrop from '../../components/layout/PageBackdrop.astro';
import SideNav from '../../components/layout/SideNav.astro';
import NotFound from '../../components/sections/NotFound.astro';
import { ui } from '../../data/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const t = ui('ru');
---

<BaseLayout title={t.notFoundTitle} description={t.notFoundDescription}>
  <PageBackdrop />
  <Header />
  <SideNav />

  <main id="main">
    <NotFound locale="ru" />
  </main>

  <Footer />
</BaseLayout>
