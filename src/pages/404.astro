---
/**
 * The not-found page, Hebrew. Built like every other route — same
 * backdrop, same chrome, same floor — because the most useful thing a
 * wrong URL can do is put the reader back in the site rather than on a
 * bare error screen: the header's nav is right there, and so is the way
 * home.
 *
 * Cloudflare serves this for any unmatched path on a static deploy
 * (`assets.not_found_handling: "404-page"` in wrangler.jsonc), so it has
 * to be a real page and not a fragment.
 *
 * ITS RUSSIAN TWIN IS src/pages/ru/404.astro, and the split is forced:
 * see NotFound.astro. Which of the two Cloudflare serves for a bad URL
 * under /ru depends on whether "404-page" walks up from the requested
 * path to find the nearest 404.html or always returns the root one — the
 * docs say the former, but it is worth confirming against the deployed
 * site rather than taking on trust. If it turns out to be the latter,
 * a Russian visitor who mistypes a URL lands on this Hebrew page, which
 * is no worse than what the site did before Russian existed, and the
 * fix is a redirect rule rather than anything in this file.
 *
 * The locale is passed to NotFound explicitly — see there for why this
 * is the one page that states its language rather than deriving it.
 */
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import PageBackdrop from '../components/layout/PageBackdrop.astro';
import SideNav from '../components/layout/SideNav.astro';
import NotFound from '../components/sections/NotFound.astro';
import { ui } from '../data/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const t = ui('he');
---

<BaseLayout title={t.notFoundTitle} description={t.notFoundDescription}>
  <PageBackdrop />
  <Header />
  <SideNav />

  <main id="main">
    <NotFound locale="he" />
  </main>

  <Footer />
</BaseLayout>
